# Variables del frontend. Copiar como client/.env
# Son públicas por diseño (Firebase protege los datos con firestore.rules).
# Si VITE_FIREBASE_API_KEY queda vacío, la app arranca en modo local de demostración.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Ruta del proxy IPFS. En desarrollo Vite redirige /api/ipfs a localhost:8787.
# En el APK de Android poner la URL completa del proxy publicado (ej. https://tu-app.vercel.app/api/ipfs).
VITE_IPFS_PROXY_URL=

# URL pública que se imprime en el QR del certificado (ej. https://tu-app.vercel.app)
VITE_PUBLIC_APP_URL=

# Red de trabajo: hardhat (nodo local o túnel) o sepolia (red de prueba pública)
VITE_CHAIN=hardhat

# Solo modo hardhat: RPC del nodo. Vacío = 127.0.0.1:8545 de la misma PC.
# Para el túnel no hace falta ponerlo aquí: se pega en la página o se abre con ?rpc=https://...
VITE_RPC_URL=

# Solo modo sepolia: RPC público (opcional; por defecto publicnode)
VITE_SEPOLIA_RPC_URL=
